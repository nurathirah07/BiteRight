# Copy to .env (never commit the real file) or set these in the Render dashboard.

# Required in production: signs session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Firebase: either paste the service-account JSON on one line...
FIREBASE_CREDENTIALS_JSON=
# ...or point to the key file.
FIREBASE_KEY_PATH=serviceAccountKey.json

# Password-reset emails (Brevo HTTPS API first, SMTP as fallback)
BREVO_API_KEY=
SENDER_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_PASSWORD=

# Optional
AUTH_REQUIRED=true
TOKEN_MAX_AGE_DAYS=30
MAX_UPLOAD_MB=10
ENABLE_DEBUG_ENDPOINTS=false
LOG_RESET_CODES=false
